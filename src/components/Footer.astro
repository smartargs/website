---
import Logo from '@/components/Logo.astro';
import { legal, site } from '@/config/site';
import { getProjects } from '@/lib/projects';

interface Props {
  /** Unity's trademark notice, for pages that name Unity. */
  unityNotice?: boolean;
}

const { unityNotice = false } = Astro.props;
const year = new Date().getFullYear();
const latest = (await getProjects()).slice(0, 4);

const columns = [
  { title: 'Site', links: site.nav },
  { title: 'Catalog', links: latest.map((project) => ({ label: project.data.title, href: `/projects/${project.id}` })) },
  {
    title: 'Legal',
    links: [
      { label: 'Impressum', href: '/impressum' },
      { label: 'Privacy', href: '/privacy' },
    ],
  },
];
---

<footer class="border-t">
  <div class="grid gap-10 px-5 py-10 sm:px-8 md:grid-cols-12">
    <div class="md:col-span-5">
      <a href="/" aria-label={`${site.name} home`} class="inline-flex rounded-md">
        <Logo />
      </a>
      <p class="mt-4 max-w-xs text-sm text-muted-foreground">Game development and software products.</p>
      <a href={`mailto:${site.email}`} class="mt-1 inline-block text-sm underline-offset-4 hover:underline">
        {site.email}
      </a>
    </div>
    <div class="grid grid-cols-2 gap-8 font-mono text-xs tracking-wider uppercase sm:grid-cols-3 md:col-span-7">
      {
        columns.map((column) => (
          <nav aria-label={column.title}>
            <h2 class="text-muted-foreground">{column.title}</h2>
            <ul class="mt-4 grid gap-2.5">
              {column.links.map((link) => (
                <li>
                  <a href={link.href} class="transition-colors hover:text-muted-foreground">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
  </div>

  <!-- Oversized wordmark. The viewBox fits Geist's glyphs: 140 above the baseline, 35 below for the g. -->
  <div class="overflow-hidden border-t px-5 pt-8 sm:px-8" aria-hidden="true">
    <svg viewBox="0 0 1000 184" class="block w-full">
      <text
        x="0"
        y="144"
        textLength="1000"
        lengthAdjust="spacing"
        font-size="212"
        class="fill-foreground font-sans font-semibold">smartargs</text
      >
    </svg>
  </div>

  <div
    class="flex flex-col gap-2 border-t px-5 py-4 font-mono text-[11px] tracking-wider text-muted-foreground uppercase sm:flex-row sm:justify-between sm:gap-8 sm:px-8"
  >
    <p class="shrink-0">© {year} {legal.businessName ?? legal.name}</p>
    {
      unityNotice && (
        <p class="max-w-2xl font-sans text-xs tracking-normal text-pretty normal-case sm:text-right">
          {site.name} is not sponsored by or affiliated with Unity Technologies or its affiliates. Unity is a trademark or
          registered trademark of Unity Technologies or its affiliates in the U.S. and elsewhere.
        </p>
      )
    }
  </div>
</footer>
