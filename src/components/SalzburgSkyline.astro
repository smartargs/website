---
import { cn } from '@/lib/utils';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// The chomper's path: along the old town, up the hill and past the fortress.
// It starts and ends just outside the frame so the chomper walks in and out.
const route = 'M-10 170 H150 C170 152 180 118 198 111 L326 109 C346 112 368 138 400 148 L412 152';
---

<!--
  Hairline view of Salzburg: Hohensalzburg Fortress on its hill, the cathedral, the Franciscan spire and the Salzach.
  A chomper runs along the ridge eating orange dots.
-->
<svg
  viewBox="0 0 400 200"
  fill="none"
  stroke="currentColor"
  stroke-linejoin="round"
  class={cn('[&_*]:[vector-effect:non-scaling-stroke]', className)}
  aria-hidden="true"
  data-skyline
>
  <!-- Festungsberg and the fortress, with the funicular -->
  <path d="M150 170 C170 152 180 118 198 111 L326 109 C346 112 368 138 400 148" />
  <path
    d="M198 111 V94 H214 V86 L218 77 L222 86 H228 V70 L236 60 H244 V50 L250 42 L256 50 V60 H262 L270 70 V84 H300 L304 78 L308 84 H316 V74 L321 66 L326 74 V109"
  />
  <path d="M235 76 h3 M243 76 h3 M251 76 h3 M259 76 h3 M277 93 h3 M285 93 h3 M293 93 h3 M301 93 h3 M309 93 h3 M204 102 h3" />
  <path d="M162 160 L206 112" stroke-dasharray="2 3" />
  <!-- Cathedral: twin towers and dome -->
  <path d="M44 170 V112 H58 V170 M82 170 V112 H96 V170" />
  <path d="M44 112 Q51 100 58 112 M51 103 V95 M82 112 Q89 100 96 112 M89 103 V95" />
  <path d="M58 130 L70 120 L82 130 M66 170 V158 Q70 152 74 158 V170" />
  <path d="M96 134 H128 V170 M102 134 V124 H122 V134 M100 124 Q112 100 124 124 M112 107 V96" />
  <!-- Franciscan church spire -->
  <path d="M134 170 V122 L139 92 L144 122 V170" />
  <!-- Old town ground and the Salzach -->
  <path d="M0 170 H150" />
  <path d="M0 184 C30 181 60 187 90 184 S150 181 180 184 S240 187 270 184 S330 181 360 184 S390 186 400 185" />
  <path d="M40 194 C70 191 100 197 130 194 S190 191 220 194 S280 197 310 194 S370 191 400 193" stroke-opacity="0.6" />

  <!-- Chomper and its dots, placed along the route by the script -->
  <path d={route} stroke="none" data-route />
  <g stroke="none" data-dots></g>
  <g stroke="none" class="fill-foreground" transform="translate(-20 0)" data-chomper>
    <path data-mouth />
    <circle cx="1.2" cy="-3.4" r="0.9" class="fill-background" />
  </g>
</svg>

<script>
  const RADIUS = 6;
  const GAP = 9;
  /** viewBox units per second */
  const SPEED = 40;
  /** Where the first lap starts, so the chomper is in view on page load. */
  const START = 22;

  /** A circle with a wedge cut out, facing +x. `open` is half the mouth angle in degrees. */
  function body(open: number) {
    const angle = (open * Math.PI) / 180;
    const x = (RADIUS * Math.cos(angle)).toFixed(2);
    const y = (RADIUS * Math.sin(angle)).toFixed(2);
    return `M0 0 L${x} -${y} A${RADIUS} ${RADIUS} 0 1 0 ${x} ${y} Z`;
  }

  function setup(svg: SVGSVGElement) {
    const route = svg.querySelector<SVGPathElement>('[data-route]');
    const layer = svg.querySelector<SVGGElement>('[data-dots]');
    const chomper = svg.querySelector<SVGGElement>('[data-chomper]');
    const mouth = chomper?.querySelector<SVGPathElement>('[data-mouth]');
    if (!route || !layer || !chomper || !mouth) return;

    const length = route.getTotalLength();
    const dots: { at: number; el: SVGCircleElement }[] = [];
    for (let at = START + GAP; at < length; at += GAP) {
      const { x, y } = route.getPointAtLength(at);
      if (x > 396) break;
      const el = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
      el.setAttribute('cx', x.toFixed(2));
      el.setAttribute('cy', y.toFixed(2));
      el.setAttribute('r', '1.5');
      el.setAttribute('class', 'fill-highlight');
      el.style.transition = 'opacity 300ms';
      layer.append(el);
      dots.push({ at, el });
    }

    let distance = START;
    let eaten = 0;
    let visible = false;
    let last = 0;
    let resumeAt = 0;
    let frame = 0;

    const eat = () => {
      while (eaten < dots.length && dots[eaten].at <= distance + RADIUS / 2) {
        dots[eaten].el.style.opacity = '0';
        eaten++;
      }
    };

    const pose = (open: number) => {
      const point = route.getPointAtLength(distance);
      const ahead = route.getPointAtLength(Math.min(length, distance + 1));
      const behind = route.getPointAtLength(Math.max(0, distance - 1));
      const angle = (Math.atan2(ahead.y - behind.y, ahead.x - behind.x) * 180) / Math.PI;
      chomper.setAttribute('transform', `translate(${point.x.toFixed(2)} ${point.y.toFixed(2)}) rotate(${angle.toFixed(1)})`);
      mouth.setAttribute('d', body(open));
    };

    const tick = (now: number) => {
      frame = 0;
      if (!visible) return;
      const seconds = last ? Math.min(0.05, (now - last) / 1000) : 0;
      last = now;
      if (now >= resumeAt) {
        distance += SPEED * seconds;
        if (distance >= length) {
          // Lap done: bring the dots back and pause before walking in again.
          distance = 0;
          eaten = 0;
          dots.forEach((dot) => (dot.el.style.opacity = '1'));
          resumeAt = now + 800;
        }
      }
      eat();
      pose(4 + 36 * Math.abs(Math.sin((now / 1000) * Math.PI * 3)));
      frame = requestAnimationFrame(tick);
    };

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      // A still frame instead: partway up the hill, with the dots behind it eaten.
      distance = length * 0.4;
      eat();
      pose(28);
      return;
    }

    pose(28);
    // Only animate while the skyline is on screen.
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !frame) {
        last = 0;
        frame = requestAnimationFrame(tick);
      }
    }).observe(svg);
  }

  document.querySelectorAll<SVGSVGElement>('svg[data-skyline]').forEach(setup);
</script>
