---
import { ChevronDown, CircleCheck, Send } from '@lucide/astro';
import { buttonVariants } from '@/components/ui/button';
import { site } from '@/config/site';
import { cn } from '@/lib/utils';

interface Props {
  /** Catalog entries a visitor can ask about; the value is the project id. */
  topics: { value: string; label: string }[];
}

const { topics } = Astro.props;

// Same styling as the shadcn/ui Input and Textarea, as plain HTML.
const control =
  'w-full min-w-0 rounded-lg border border-input bg-card px-3 text-base transition-colors outline-none placeholder:text-muted-foreground focus-visible:border-ring focus-visible:ring-3 focus-visible:ring-ring/50 disabled:cursor-not-allowed disabled:opacity-50 md:text-sm dark:bg-input/30';
const label = 'font-pixel text-[11px] tracking-wider text-muted-foreground uppercase';
---

<div>
  <form id="contact-form" method="post" action="/api/contact" class="grid gap-6">
    <div class="grid gap-6 sm:grid-cols-2">
      <div class="grid gap-2">
        <label for="name" class={label}>Name</label>
        <input id="name" name="name" type="text" required maxlength="100" autocomplete="name" class={cn(control, 'h-11')} />
      </div>
      <div class="grid gap-2">
        <label for="email" class={label}>Email</label>
        <input id="email" name="email" type="email" required maxlength="254" autocomplete="email" class={cn(control, 'h-11')} />
      </div>
    </div>

    <div class="grid gap-6 sm:grid-cols-2">
      <div class="grid gap-2">
        <label for="company" class={label}>Company <span class="normal-case opacity-70">(optional)</span></label>
        <input id="company" name="company" type="text" maxlength="100" autocomplete="organization" class={cn(control, 'h-11')} />
      </div>
      <div class="grid gap-2">
        <label for="topic" class={label}>Regarding</label>
        <div class="relative">
          <select id="topic" name="topic" class={cn(control, 'h-11 appearance-none pr-9')}>
            {
              topics.length > 0 && (
                <optgroup label="Catalog">
                  {topics.map((topic) => (
                    <option value={topic.value}>{topic.label}</option>
                  ))}
                </optgroup>
              )
            }
            <option value="other">Something else</option>
          </select>
          <ChevronDown class="pointer-events-none absolute top-1/2 right-3 size-4 -translate-y-1/2 text-muted-foreground" />
        </div>
      </div>
    </div>

    <div class="grid gap-2">
      <label for="message" class={label}>Message</label>
      <textarea
        id="message"
        name="message"
        required
        minlength="10"
        maxlength="5000"
        rows="7"
        class={cn(control, 'field-sizing-content min-h-44 py-2.5')}></textarea>
    </div>

    <!-- Honeypot: hidden from people, filled in by bots. -->
    <div class="hidden" aria-hidden="true">
      <label>Leave this field empty <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>

    <div class="cf-turnstile" data-sitekey={site.turnstileSiteKey} data-size="flexible" data-theme="auto"></div>

    <div class="flex flex-col gap-4 border-t pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-xs text-xs leading-relaxed text-muted-foreground">
        We use your details only to answer your message. See the <a
          href="/privacy"
          class="underline underline-offset-4 hover:text-foreground">privacy policy</a
        >.
      </p>
      <button type="submit" class={cn(buttonVariants({ size: 'lg' }), 'h-11 px-5')}>
        <span class="group-data-loading/button:hidden">Send message</span>
        <span class="hidden group-data-loading/button:inline">Sending…</span>
        <Send />
      </button>
    </div>
    <p data-status role="status" aria-live="polite" class="text-sm text-destructive empty:hidden"></p>

    <noscript>
      <p class="text-sm text-muted-foreground">
        The form needs JavaScript for its spam check. You can also email <a href={`mailto:${site.email}`} class="underline"
          >{site.email}</a
        >.
      </p>
    </noscript>
  </form>

  <div data-success hidden class="py-16">
    <CircleCheck class="size-10 text-emerald-500" />
    <h2 class="mt-6 text-4xl font-semibold tracking-[-0.04em]">
      Message <span class="text-muted-foreground">sent.</span>
    </h2>
    <p class="mt-3 text-muted-foreground">Thanks for reaching out. We'll get back to you by email.</p>
  </div>
</div>

<script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  type Result = { ok: boolean; error?: string };
  type TurnstileWindow = Window & { turnstile?: { reset: () => void } };

  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const status = form?.querySelector<HTMLElement>('[data-status]');
  const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const success = document.querySelector<HTMLElement>('[data-success]');

  if (form && status && submit && success) {
    // Links like /contact?topic=vantage-dev preselect the topic.
    const topic = new URLSearchParams(location.search).get('topic');
    const select = form.elements.namedItem('topic');
    if (topic && select instanceof HTMLSelectElement && [...select.options].some((option) => option.value === topic)) {
      select.value = topic;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.textContent = '';
      submit.disabled = true;
      submit.dataset.loading = '';

      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const result = (await response.json().catch(() => null)) as Result | null;
        if (response.ok && result?.ok) {
          form.hidden = true;
          success.hidden = false;
          return;
        }
        status.textContent = result?.error ?? 'Something went wrong. Please try again, or email us directly.';
      } catch {
        status.textContent = 'Could not reach the server. Check your connection and try again.';
      } finally {
        submit.disabled = false;
        delete submit.dataset.loading;
        // Turnstile tokens are single-use.
        (window as TurnstileWindow).turnstile?.reset();
      }
    });
  }
</script>
