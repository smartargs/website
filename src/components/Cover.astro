---
import type { CoverPattern } from '@/lib/projects';
import { cn } from '@/lib/utils';

interface Props {
  pattern: CoverPattern;
  color: string;
  glyph: string;
  size?: 'md' | 'lg';
  class?: string;
}

const { pattern, color, glyph, size = 'md', class: className } = Astro.props;

// Every pattern is drawn on a 400×300 canvas, then cropped to fill its container.
const range = (count: number) => Array.from({ length: count }, (_, i) => i);

const rings = range(16).map((i) => 12 + i * 20);

const horizon = 110;
const floorLines = range(9).map((i) => horizon + (300 - horizon) * ((i + 1) / 9) ** 2);
const rays = range(21).map((i) => -600 + i * 80);

const stripes = range(46).map((i) => -320 + i * 16);

const dots = range(15).flatMap((row) =>
  range(20).map((column) => {
    const x = 10 + column * 20;
    const y = 10 + row * 20;
    return { x, y, r: Math.max(0.8, 7 * (1 - Math.hypot(x - 330, y - 50) / 380)) };
  }),
);

const waves = range(14).map((i) => {
  const base = 10 + i * 22;
  const amplitude = 5 + i * 0.9;
  return range(42)
    .map((step) => `${step === 0 ? 'M' : 'L'}${step * 10} ${(base + Math.sin((step * 10) / 38 + i * 0.55) * amplitude).toFixed(1)}`)
    .join(' ');
});

const blocks = range(10).map((i) => ({ x: 22 + i * 37, height: 50 + ((i * 53) % 9) * 24 }));

// A signature written across the ruled lines of a document. The hand is built from three
// cursive moves, written upright and then sheared so the whole name leans forward.
const baseline = 168;
const pen: string[] = [];
let penX = 0;

/** Every point leans forward by its height above the baseline, the slant of a hand. */
const lean = ([x, y]: [number, number]) => `${(x + (baseline - y) * 0.16).toFixed(1)} ${y.toFixed(1)}`;
const curve = (...points: [number, number][]) => pen.push(`C${points.map(lean).join(' ')}`);
/** Start a stroke, after the pen has left the page. */
const lift = (x: number) => {
  penX = x;
  pen.push(`M${lean([x, baseline])}`);
};
/** The arch of an n or m: steep up, round over, steep down. */
const arch = (to: number, height: number) => {
  const w = to - penX;
  curve([penX + w * 0.12, baseline - height * 1.14], [to - w * 0.12, baseline - height * 1.14], [to, baseline]);
  penX = to;
};
/** A tall ascender that loops back through itself, as in l, b or a capital. */
const ascender = (to: number, height: number) => {
  const w = to - penX;
  curve([penX + w * 0.05, baseline - height * 0.55], [penX + w * 0.1, baseline - height], [penX + w * 0.45, baseline - height]);
  curve([penX + w * 0.78, baseline - height], [penX + w * 0.62, baseline - height * 0.42], [penX + w * 0.42, baseline - height * 0.1]);
  curve([penX + w * 0.3, baseline + 2], [penX + w * 0.72, baseline + 2], [to, baseline]);
  penX = to;
};
/** A tail below the line that loops back up, as in g or y. */
const descender = (to: number, depth: number) => {
  const w = to - penX;
  curve([penX + w * 0.35, baseline + depth * 0.55], [penX + w * 0.05, baseline + depth], [penX + w * 0.4, baseline + depth]);
  curve([penX + w * 0.78, baseline + depth], [penX + w * 0.9, baseline + depth * 0.35], [to, baseline]);
  penX = to;
};

// A first name, a second name, and a flourish that sweeps back under them.
lift(68);
ascender(99, 60);
arch(112, 23);
arch(125, 22);
ascender(140, 46);
arch(153, 24);
descender(169, 24);
arch(182, 22);

lift(197);
ascender(229, 58);
arch(242, 23);
arch(255, 25);
ascender(270, 44);
arch(283, 22);
arch(296, 24);

curve([310, baseline - 6], [327, baseline - 16], [334, baseline - 25]);
curve([340, baseline - 32], [343, baseline - 13], [329, baseline - 2]);
curve([313, baseline + 8], [286, baseline + 11], [252, baseline + 8]);
curve([245, baseline + 7], [240, baseline + 5], [238, baseline + 1]);

const signature = pen.join(' ');
const signatureLine = baseline + 18;

// The document's text, in lines of uneven length, leaving the signature room to breathe.
const ruledWidths = [336, 292, 330, 248, 340, 306, 322, 264, 318, 288];
const ruled = range(24)
  .map((i) => 6 + i * 13)
  .filter((y) => y < baseline - 66 || y > baseline + 32)
  .map((y, i) => ({ y, width: ruledWidths[i % ruledWidths.length] }));
---

<div class={cn('absolute inset-0 overflow-hidden', className)} style={`background-color: ${color}`} aria-hidden="true">
  <svg
    viewBox="0 0 400 300"
    preserveAspectRatio="xMidYMid slice"
    fill="none"
    stroke="white"
    stroke-opacity="0.3"
    class="absolute inset-0 size-full [&_*]:[vector-effect:non-scaling-stroke]"
  >
    {
      pattern === 'rings' && (
        <>
          {rings.map((r) => (
            <circle cx="270" cy="150" r={r} />
          ))}
          <line x1="270" y1="150" x2="400" y2="70" stroke-opacity="0.75" />
          <circle cx="270" cy="150" r="5" fill="white" stroke="none" />
        </>
      )
    }
    {
      pattern === 'grid' && (
        <>
          {floorLines.map((y) => (
            <line x1="0" y1={y} x2="400" y2={y} />
          ))}
          {rays.map((x) => (
            <line x1="200" y1={horizon} x2={x} y2="300" />
          ))}
          <line x1="0" y1={horizon} x2="400" y2={horizon} stroke-opacity="0.75" />
          <circle cx="200" cy={horizon - 38} r="30" fill="white" fill-opacity="0.9" stroke="none" />
        </>
      )
    }
    {
      pattern === 'stripes' && (
        <>
          {stripes.map((x) => (
            <line x1={x} y1="0" x2={x + 300} y2="300" />
          ))}
          <circle cx="130" cy="150" r="80" fill={color} stroke-opacity="0.85" />
          <circle cx="130" cy="150" r="46" stroke-opacity="0.5" />
        </>
      )
    }
    {
      pattern === 'dots' &&
        dots.map(({ x, y, r }) => <circle cx={x} cy={y} r={r.toFixed(2)} fill="white" fill-opacity="0.55" stroke="none" />)
    }
    {pattern === 'waves' && waves.map((d) => <path d={d} />)}
    {
      pattern === 'blocks' &&
        blocks.map(({ x, height }) => (
          <rect x={x} y={300 - height} width="26" height={height} fill="white" fill-opacity="0.12" />
        ))
    }
    {
      pattern === 'signature' && (
        <>
          {ruled.map(({ y, width }) => (
            <line x1="30" y1={y} x2={30 + width} y2={y} />
          ))}
          <line x1="58" y1={signatureLine} x2="342" y2={signatureLine} stroke-opacity="0.55" />
          <path d={`M60 ${signatureLine - 6} l7 11 M67 ${signatureLine - 6} l-7 11`} stroke-opacity="0.6" />
          <path d={signature} stroke-opacity="0.95" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
        </>
      )
    }
  </svg>
  <span
    class={cn(
      'absolute font-pixel leading-none font-medium tracking-tighter text-white',
      size === 'lg' ? 'bottom-5 left-5 text-6xl sm:bottom-8 sm:left-8 sm:text-8xl' : 'bottom-4 left-4 text-4xl',
    )}
  >
    {glyph}
  </span>
</div>
