---
import { statusLabels, type ProjectStatus } from '@/lib/projects';
import { cn } from '@/lib/utils';

interface Props {
  status: ProjectStatus;
}

const { status } = Astro.props;

const dotColors: Record<ProjectStatus, string> = {
  available: 'bg-emerald-500',
  'in-development': 'bg-amber-500',
  'coming-soon': 'bg-sky-500',
  archived: 'bg-muted-foreground',
};
---

<span class="inline-flex items-center gap-1.5">
  <span class={cn('size-1.5 rounded-full', dotColors[status])}></span>
  {statusLabels[status]}
</span>
