---
import { ArrowRight } from '@lucide/astro';
---

<section class="border-t">
  <a
    href="/contact"
    class="group flex flex-col gap-8 px-5 py-12 transition-colors duration-300 hover:bg-foreground hover:text-background sm:px-8 sm:py-16 md:flex-row md:items-end md:justify-between"
  >
    <div>
      <p class="font-mono text-[11px] tracking-wider text-muted-foreground uppercase transition-colors group-hover:text-background/60">
        Have something in mind?
      </p>
      <p class="mt-4 text-[length:clamp(2.5rem,6vw,5rem)] leading-[0.95] font-semibold tracking-[-0.045em]">
        Let's build it <span class="text-muted-foreground transition-colors group-hover:text-background/50">together.</span>
      </p>
    </div>
    <span
      class="inline-flex size-14 shrink-0 items-center justify-center rounded-full border border-current transition-transform duration-300 group-hover:-rotate-45 sm:size-20"
    >
      <ArrowRight class="size-6 sm:size-8" />
    </span>
  </a>
</section>
