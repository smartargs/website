---
import ProjectCard from '@/components/ProjectCard.astro';
import SalzburgSkyline from '@/components/SalzburgSkyline.astro';
import { site } from '@/config/site';
import Layout from '@/layouts/Layout.astro';
import { getProjects, mentionsUnity, slugify } from '@/lib/projects';

const projects = await getProjects();

const categories = [
  { id: 'all', label: 'All', count: projects.length },
  ...[...new Set(projects.map((project) => project.data.category))].map((label) => ({
    id: slugify(label),
    label,
    count: projects.filter((project) => project.data.category === label).length,
  })),
];

// Filtering is CSS only: a checked radio hides every card of another category.
const filterCss = categories
  .filter(({ id }) => id !== 'all')
  .map(({ id }) => `#catalog:has(#filter-${id}:checked) [data-category]:not([data-category="${id}"]){display:none}`)
  .join('');

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site.url}/#organization`,
      name: site.name,
      url: site.url,
      logo: `${site.url}/apple-touch-icon.png`,
    },
    {
      '@type': 'WebSite',
      '@id': `${site.url}/#website`,
      name: site.name,
      url: site.url,
      publisher: { '@id': `${site.url}/#organization` },
    },
    {
      '@type': 'ItemList',
      name: `${site.name} catalog`,
      itemListElement: projects.map((project, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: project.data.title,
        url: `${site.url}/projects/${project.id}`,
      })),
    },
  ],
};
---

<Layout jsonLd={jsonLd} unityNotice={projects.some(mentionsUnity)}>
  <style is:inline set:html={filterCss}></style>

  <section class="grid border-b lg:grid-cols-12">
    <div class="px-5 pt-14 pb-12 sm:px-8 sm:pt-20 sm:pb-16 lg:col-span-8 lg:border-r lg:pb-20">
      <h1 class="text-[length:clamp(3.25rem,8vw,7.5rem)] leading-[0.92] font-semibold tracking-[-0.055em]">
        <span class="block">Useful software,</span>
        <span class="block text-muted-foreground">built to last<span class="text-highlight">.</span></span>
      </h1>
    </div>
    <div class="flex flex-col gap-8 border-t px-5 py-10 sm:px-8 lg:col-span-4 lg:justify-between lg:border-t-0 lg:py-14">
      <figure>
        <SalzburgSkyline class="w-full max-w-md text-muted-foreground" />
        <figcaption class="mt-3 font-mono text-[11px] tracking-wider uppercase">Salzburg, Austria</figcaption>
      </figure>
      <p class="max-w-sm text-pretty text-muted-foreground">
        smartargs is a game development company. This is where we publish the products and tools we build. Browse the
        catalog, or get in touch to build something new.
      </p>
    </div>
  </section>

  <section id="catalog" aria-labelledby="catalog-title">
    <div
      class="sticky top-14 z-30 flex flex-wrap items-center gap-x-6 gap-y-3 border-b bg-background/85 px-5 py-3 backdrop-blur-md sm:px-8"
    >
      <h2 id="catalog-title" class="font-mono text-[11px] tracking-wider uppercase">
        Catalog <span class="text-muted-foreground">({String(projects.length).padStart(2, '0')})</span>
      </h2>
      <fieldset class="flex flex-wrap gap-1.5">
        <legend class="sr-only">Filter by category</legend>
        {
          categories.map((category) => (
            <label class="inline-flex h-7 cursor-pointer items-center gap-1.5 rounded-full border px-3 text-xs font-medium transition-colors select-none hover:bg-muted has-checked:border-foreground has-checked:bg-foreground has-checked:text-background has-focus-visible:ring-3 has-focus-visible:ring-ring/50">
              <input
                type="radio"
                name="filter"
                id={`filter-${category.id}`}
                checked={category.id === 'all'}
                class="sr-only"
              />
              {category.label}
              <span class="font-mono text-[10px] opacity-60">{category.count}</span>
            </label>
          ))
        }
      </fieldset>
    </div>

    <div class="overflow-hidden">
      <ul class="-mr-px -mb-px grid sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project, index) => <ProjectCard project={project} index={index} wide={index === 0} />)}
      </ul>
    </div>
  </section>
</Layout>
