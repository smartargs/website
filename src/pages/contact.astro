---
import ContactForm from '@/components/ContactForm.astro';
import MetaBar from '@/components/MetaBar.astro';
import { site } from '@/config/site';
import Layout from '@/layouts/Layout.astro';
import { getProjects } from '@/lib/projects';

const topics = (await getProjects()).map((project) => ({ value: project.id, label: project.data.title }));
---

<Layout title="Contact" description="Get in touch with smartargs about something in the catalog, a software project, or anything else.">
  <MetaBar>
    <span>Enquiries</span>
    <span>Replies by email</span>
  </MetaBar>

  <section class="grid lg:grid-cols-12">
    <div class="border-b px-5 pt-12 pb-10 sm:px-8 sm:pt-16 lg:col-span-5 lg:border-r lg:border-b-0 lg:pb-16">
      <h1 class="text-[length:clamp(3.25rem,8vw,7rem)] leading-[0.88] font-semibold tracking-[-0.055em]">
        Let's <span class="text-muted-foreground">talk.</span>
      </h1>
      <p class="mt-6 max-w-sm text-pretty text-muted-foreground">
        A question about something in the catalog, a project you'd like help with, or anything else. Your message goes
        straight to our inbox.
      </p>
      <dl class="mt-12 font-pixel text-xs tracking-wider uppercase">
        <div class="flex items-center justify-between gap-4 border-y py-3">
          <dt class="text-muted-foreground">Email</dt>
          <dd class="truncate normal-case"><a href={`mailto:${site.email}`} class="hover:underline">{site.email}</a></dd>
        </div>
      </dl>
    </div>

    <div class="px-5 py-10 sm:px-8 sm:py-16 lg:col-span-7 lg:px-14">
      <ContactForm topics={topics} />
    </div>
  </section>
</Layout>
