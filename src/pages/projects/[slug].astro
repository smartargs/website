---
import { render } from 'astro:content';
import { ArrowLeft, ArrowUpRight, BookOpen } from '@lucide/astro';
import Cover from '@/components/Cover.astro';
import EnquiryStrip from '@/components/EnquiryStrip.astro';
import LinkButton from '@/components/LinkButton.astro';
import MetaBar from '@/components/MetaBar.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import StatusBadge from '@/components/StatusBadge.astro';
import { site } from '@/config/site';
import Layout from '@/layouts/Layout.astro';
import { docHref, getDocs } from '@/lib/docs';
import { catalogNumber, getProjects, type Project } from '@/lib/projects';
import { cn } from '@/lib/utils';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      index,
      total: projects.length,
      others: projects
        .map((other, otherIndex) => ({ project: other, index: otherIndex }))
        .filter((other) => other.project.id !== project.id)
        .slice(0, 3),
    },
  }));
}

interface Props {
  project: Project;
  index: number;
  total: number;
  others: { project: Project; index: number }[];
}

const { project, index, total, others } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);

const sections = headings.filter((heading) => heading.depth === 2);
const pad = (value: number) => String(value).padStart(2, '0');
const enquireHref = `/contact?topic=${project.id}`;
const [primary, ...secondary] = data.links;
// A folder in src/content/docs/<id> adds a Documentation button automatically.
const hasDocs = (await getDocs(project.id)).length > 0;

const facts = [
  { label: 'Status', value: null },
  ...(data.version ? [{ label: 'Version', value: `v${data.version}` }] : []),
  { label: 'Year', value: String(data.year) },
  ...(data.price ? [{ label: 'Price', value: data.price }] : []),
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: data.title,
  description: data.description,
  url: `${site.url}/projects/${project.id}`,
  applicationCategory: data.category,
  ...(data.version && { softwareVersion: data.version }),
  ...(data.tags.length > 0 && { keywords: data.tags.join(', ') }),
  publisher: { '@type': 'Organization', name: site.name, url: site.url },
};
---

<Layout title={`${data.title}, ${data.category}`} description={data.description} jsonLd={jsonLd}>
  <article>
    <MetaBar>
      <a href="/#catalog" class="flex items-center gap-2 transition-colors hover:text-foreground">
        <ArrowLeft class="size-3.5" /> Catalog
      </a>
      <span>{catalogNumber(index)} <span class="opacity-50">/ {pad(total)}</span></span>
    </MetaBar>

    <header class="grid border-b lg:grid-cols-12">
      <div class="px-5 pt-12 pb-10 sm:px-8 sm:pt-16 sm:pb-14 lg:col-span-8 lg:border-r">
        <p class="font-mono text-[11px] tracking-wider text-muted-foreground uppercase">{data.category}</p>
        <h1 class="mt-5 text-[length:clamp(3.5rem,11vw,9.5rem)] leading-[0.85] font-semibold tracking-[-0.06em] break-words">
          {data.title}
        </h1>
        <p class="mt-6 max-w-2xl text-xl text-pretty text-muted-foreground sm:text-2xl">{data.tagline}</p>
        {
          data.tags.length > 0 && (
            <ul class="mt-6 flex flex-wrap gap-2" aria-label="Tags">
              {data.tags.map((tag) => (
                <li class="rounded-full border px-2.5 py-1 font-mono text-xs text-muted-foreground">#{tag}</li>
              ))}
            </ul>
          )
        }
      </div>

      <aside class="flex flex-col gap-10 border-t px-5 py-8 sm:px-8 lg:col-span-4 lg:border-t-0 lg:py-16">
        <dl class="font-mono text-xs tracking-wider uppercase">
          {
            facts.map((fact) => (
              <div class="flex items-center justify-between gap-4 border-t py-3 last:border-b">
                <dt class="text-muted-foreground">{fact.label}</dt>
                <dd>{fact.value ?? <StatusBadge status={data.status} />}</dd>
              </div>
            ))
          }
        </dl>
        <div class="mt-auto grid gap-2">
          <LinkButton href={primary?.href ?? enquireHref} size="lg" class="h-11 justify-between px-4">
            {primary?.label ?? `Enquire about ${data.title}`}
            <ArrowUpRight />
          </LinkButton>
          {
            hasDocs && (
              <LinkButton href={docHref(project.id)} size="lg" variant="outline" class="h-11 justify-between px-4">
                Documentation
                <BookOpen />
              </LinkButton>
            )
          }
          {
            secondary.map((link) => (
              <LinkButton href={link.href} size="lg" variant="outline" class="h-11 justify-between px-4">
                {link.label}
                <ArrowUpRight />
              </LinkButton>
            ))
          }
          {
            primary && (
              <LinkButton href={enquireHref} size="lg" variant="ghost" class="h-11 justify-between px-4">
                Ask a question
                <ArrowUpRight />
              </LinkButton>
            )
          }
        </div>
      </aside>
    </header>

    <div class="border-b p-3 sm:p-4">
      <div class="relative aspect-16/10 overflow-hidden rounded-lg sm:aspect-21/8">
        <Cover {...data.cover} size="lg" />
      </div>
    </div>

    {
      data.specs.length > 0 && (
        <div class="overflow-hidden border-b">
          <dl class="-mr-px -mb-px grid grid-cols-2 md:grid-cols-4">
            {data.specs.map((spec) => (
              <div class="cell-lines min-w-0 px-5 py-4 sm:px-8">
                <dt class="font-mono text-[11px] tracking-wider text-muted-foreground uppercase">{spec.label}</dt>
                <dd class="mt-1.5 truncate text-sm font-medium">{spec.value}</dd>
              </div>
            ))}
          </dl>
        </div>
      )
    }

    <div class="grid lg:grid-cols-12">
      {
        sections.length > 1 && (
          <aside class="hidden border-r lg:col-span-3 lg:block">
            <nav aria-label="On this page" class="sticky top-14 px-8 py-14 font-mono text-xs tracking-wider uppercase">
              <p class="text-muted-foreground">On this page</p>
              <ol class="mt-5 grid gap-3">
                {sections.map((heading, i) => (
                  <li>
                    <a href={`#${heading.slug}`} class="flex gap-3 transition-colors hover:text-muted-foreground">
                      <span class="text-muted-foreground">{pad(i + 1)}</span>
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ol>
            </nav>
          </aside>
        )
      }
      <div class={cn('prose-project min-w-0 px-5 py-12 sm:px-8 sm:py-16', sections.length > 1 ? 'lg:col-span-9 lg:px-14' : 'lg:col-span-12')}>
        <Content />
      </div>
    </div>

    {
      others.length > 0 && (
        <section class="border-t">
          <MetaBar>
            <h2>More from the catalog</h2>
            <a href="/#catalog" class="transition-colors hover:text-foreground">
              View all
            </a>
          </MetaBar>
          <div class="overflow-hidden">
            <ul class="-mr-px -mb-px grid sm:grid-cols-2 lg:grid-cols-3">
              {others.map((other) => (
                <ProjectCard project={other.project} index={other.index} featured={false} />
              ))}
            </ul>
          </div>
        </section>
      )
    }
  </article>

  <EnquiryStrip />
</Layout>
